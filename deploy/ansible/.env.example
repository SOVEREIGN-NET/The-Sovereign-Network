# Deployment target configuration.
# Copy this file to .env and fill in your values.
# Source before running Ansible:  source .env

# Comma-separated list of target host IPs
ZHTP_DEPLOY_HOSTS="192.168.1.10,192.168.1.20"

# SSH user for deployment
ZHTP_DEPLOY_USER="root"

# Path to the SSH private key
ZHTP_DEPLOY_SSH_KEY="~/.ssh/id_ed25519"
